# Copy to .env for local development. Real deployments set these in the environment.
DATABASE_URL=postgres://restaurant:restaurant@localhost:5432/restaurant
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to false only for plain-http local development.
DJANGO_SECURE_COOKIES=false
RESTAURANT_TIME_ZONE=Europe/Helsinki
# Where checklist issue photos are stored. Must NOT be inside a public web root.
PRIVATE_UPLOAD_ROOT=./private_uploads
ISSUE_PHOTO_MAX_BYTES=10485760
# Dish photos, logo and hero image. Served through the app (drafts stay hidden).
PUBLIC_UPLOAD_ROOT=./public_uploads
MENU_PHOTO_MAX_BYTES=10485760
PASSWORD_SETUP_LINK_TIMEOUT=259200

# --- Platform (multi-restaurant) ---
# Local development: with TENANT_SUBDOMAINS=true and PLATFORM_DOMAIN=localhost, open
# http://localhost:8000 for the platform and http://<slug>.localhost:8000 for a restaurant
# (browsers resolve *.localhost to your own computer). With false, restaurants are chosen
# on the "Staff sign-in" page and remembered in the session.
PLATFORM_DOMAIN=localhost
TENANT_SUBDOMAINS=true
PLATFORM_NAME=Restaurant Platform
TRIAL_DAYS=14
# First platform administrator (python manage.py ensure_platform_admin)
# INITIAL_ADMIN_LOGIN=admin
# INITIAL_ADMIN_PASSWORD=choose-a-long-password
